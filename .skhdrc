# Move window
shift + alt - 1 : ~/.yabai/space-map.sh move 1
shift + alt - 2 : ~/.yabai/space-map.sh move 2
shift + alt - 3 : ~/.yabai/space-map.sh move 3
shift + alt - 4 : ~/.yabai/space-map.sh move 4
shift + alt - 5 : ~/.yabai/space-map.sh move 5
shift + alt - 6 : ~/.yabai/space-map.sh move 6
shift + alt - 7 : ~/.yabai/space-map.sh move 7
shift + alt - 8 : ~/.yabai/space-map.sh move 8
shift + alt - 9 : ~/.yabai/space-map.sh move 9
shift + alt - 0 : ~/.yabai/space-map.sh move 0

# Focus space
alt - 1 : ~/.yabai/space-map.sh focus 1
alt - 2 : ~/.yabai/space-map.sh focus 2
alt - 3 : ~/.yabai/space-map.sh focus 3
alt - 4 : ~/.yabai/space-map.sh focus 4
alt - 5 : ~/.yabai/space-map.sh focus 5
alt - 6 : ~/.yabai/space-map.sh focus 6
alt - 7 : ~/.yabai/space-map.sh focus 7
alt - 8 : ~/.yabai/space-map.sh focus 8
alt - 9 : ~/.yabai/space-map.sh focus 9
alt - 0 : ~/.yabai/space-map.sh focus 0

# Float toggle
alt - space : yabai -m window --toggle float